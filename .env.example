# ==============================================================================
# MEME MARKET FORENSIC RESEARCH AGENT — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Direct links to get every API key are provided above each section.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
# Fill only providers referenced by api_key_env in config.yaml.
# Model names, endpoint URLs, temperatures, and fallback order belong in config.yaml.

# 9Router local proxy key: create/copy from your local 9Router dashboard.
NINEROUTER_API_KEY=""

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# Groq: https://console.groq.com/keys
GROQ_API_KEY=""

# Together AI: https://api.together.ai/settings/api-keys
TOGETHERAI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. FACELESS REEL AUDIO / TTS (PETER & STEWIE VOICES)
# ------------------------------------------------------------------------------
# Fish Audio provides the ultra-realistic character voices for viral reels.
#   - Peter Griffin voiceId: a84d19016bc34098b3c89d78f9299e33
#   - Stewie Griffin voiceId: e91c4f5974f149478a35affe820d02ac
# Get your Fish Audio API key: https://fish.audio/app/api-keys
FISH_API_KEY="your_fish_audio_api_key_here"

# (Optional) Override path for Faceless config directory
# FACELESS_CONFIG_DIR="~/.faceless"

# ------------------------------------------------------------------------------
# 3. SEC EDGAR OFFICIAL COMPLIANCE IDENTITY (REQUIRED BY SEC.GOV)
# ------------------------------------------------------------------------------
# The SEC requires all automated scripts to provide a User-Agent in the format:
#   "Sample Company Name AdminContact@<sample company domain>.com"
# Read official policy: https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT="MemeTradingResearch andangtruong085@gmail.com"
EDGAR_IDENTITY="MemeTradingResearch andangtruong085@gmail.com"

# ------------------------------------------------------------------------------
# 4. OPTIONAL FINANCIAL & MACRO DATA PROVIDERS (FREE TIERS)
# ------------------------------------------------------------------------------
# System runs keylessly by default with yfinance, edgartools, and ApeWisdom.
# These optional free-tier keys provide supplemental data:

# Finnhub (Free tier: 60 req/min) — Insider Form 4 transactions & analyst consensus
# Get your free key: https://finnhub.io/dashboard
FINNHUB_API_KEY=""

# FRED / Federal Reserve Economic Data (Free tier: 120 req/min) — Macro indicators
# Get your free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""

# Apify (Free recurring credits) — Twitter / X cashtag scraper
# Get your free token: https://console.apify.com/account/integrations
APIFY_API_TOKEN=""

# ------------------------------------------------------------------------------
# 5. OPTIONAL SOCIAL MEDIA SCRAPING (REDDIT PRAW)
# ------------------------------------------------------------------------------
# For scraping Reddit (r/wallstreetbets, r/stocks, r/buildapc) with official PRAW:
# Create a script app to get credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="MemeTradingAgent:v1.0 (by /u/your_username)"
