---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SearchModal from '../components/SearchModal.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
// Sort newest first
articles.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const featuredArticle = articles[0];
const remainingArticles = articles.slice(1);
const totalCitations = articles.reduce((acc, curr) => acc + (curr.data.citations?.length || 0), 0);
---

<Layout title="The Meme Forensic Journal — Institutional Equity Diligence">
  <Header slot="header" activeNav="articles" />
  <SearchModal />

  <!-- Journal Header Introduction -->
  <section class="mb-10 pb-8 border-b border-journal-border dark:border-night-border text-center sm:text-left">
    <div class="max-w-3xl">
      <h1 class="text-2xl sm:text-3xl font-serif font-bold text-journal-ink dark:text-night-ink tracking-tight mb-2">
        Forensic Intelligence & Valuation Expectation Audits
      </h1>
      <p class="text-sm sm:text-base font-serif italic text-journal-secondary dark:text-night-secondary leading-relaxed">
        We investigate grassroots market hype against audited balance sheet forensics, Reverse DCF implied growth rates, and primary SEC EDGAR regulatory receipts.
      </p>
    </div>
  </section>

  <!-- Featured Lead Investigation -->
  {featuredArticle && (
    <section class="mb-12">
      <div class="p-6 sm:p-8 rounded-xl bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border shadow-sm hover:border-journal-borderHover dark:hover:border-night-borderHover transition-colors">
        <div class="flex flex-wrap items-center gap-2.5 mb-3 text-xs font-sans text-journal-secondary dark:text-night-secondary">
          <span class="font-mono font-bold text-journal-ink dark:text-night-ink px-2 py-0.5 rounded bg-journal-bg dark:bg-night-bg border border-journal-border dark:border-night-border">
            ${featuredArticle.data.ticker}
          </span>
          <span class="text-journal-muted dark:text-night-muted">•</span>
          <span class="font-sans uppercase text-[10px] tracking-wider px-2 py-0.5 rounded border font-semibold bg-amber-50 dark:bg-amber-950/40 text-editorial-crimson dark:text-editorial-crimsonDark border-amber-200 dark:border-amber-900/50">
            {featuredArticle.data.verdict}
          </span>
          <span class="text-journal-muted dark:text-night-muted ml-auto font-mono text-[11px]">
            {featuredArticle.data.publishedAt}
          </span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold tracking-tight text-journal-ink dark:text-night-ink mb-4 leading-snug">
          <a href={`/articles/${featuredArticle.id}`} class="hover:text-editorial-blue dark:hover:text-editorial-blueDark transition-colors">
            {featuredArticle.data.title}
          </a>
        </h2>

        <p class="text-base font-serif italic text-journal-lead dark:text-night-lead leading-relaxed mb-6 max-w-4xl">
          {featuredArticle.data.thesis}
        </p>

        <!-- Metric Callout Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 p-3 rounded-lg bg-journal-bg/60 dark:bg-night-bg/60 border border-journal-border/50 dark:border-night-border/50 text-xs mb-6 max-w-3xl">
          <div>
            <span class="text-[10px] font-sans uppercase tracking-wider text-journal-muted dark:text-night-muted block">Implied Growth:</span>
            <span class="font-mono font-bold text-journal-ink dark:text-night-ink text-sm mt-0.5 block">{featuredArticle.data.reverseDcfImpliedGrowth || 'N/A'}</span>
          </div>
          <div>
            <span class="text-[10px] font-sans uppercase tracking-wider text-journal-muted dark:text-night-muted block">Fair Value Model:</span>
            <span class="font-mono font-bold text-editorial-emerald dark:text-editorial-emeraldDark text-sm mt-0.5 block">{featuredArticle.data.targetValuation || 'N/A'}</span>
          </div>
          <div>
            <span class="text-[10px] font-sans uppercase tracking-wider text-journal-muted dark:text-night-muted block">M-Score Risk:</span>
            <span class="font-mono font-bold text-journal-lead dark:text-night-lead text-sm mt-0.5 block">{featuredArticle.data.beneishMScore || 'Normal'}</span>
          </div>
          <div>
            <span class="text-[10px] font-sans uppercase tracking-wider text-journal-muted dark:text-night-muted block">Regulatory Receipts:</span>
            <span class="font-mono font-bold text-editorial-blue dark:text-editorial-blueDark text-sm mt-0.5 block">{featuredArticle.data.citations?.length || 0} Audited</span>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-journal-border/40 dark:border-night-border/40 text-xs font-sans">
          <div class="flex items-center gap-2 text-journal-muted dark:text-night-muted font-mono text-[11px]">
            {featuredArticle.data.video?.id && (
              <span class="text-editorial-emerald dark:text-editorial-emeraldDark">● Video Briefing Included</span>
            )}
          </div>
          <a
            href={`/articles/${featuredArticle.id}`}
            class="text-editorial-blue dark:text-editorial-blueDark hover:underline font-medium flex items-center gap-1.5"
          >
            <span>Read Complete Forensic Audit</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Filter Strip -->
  <section class="mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-journal-border dark:border-night-border text-xs font-sans">
      <div class="flex items-center gap-2 overflow-x-auto">
        <span class="text-journal-muted dark:text-night-muted text-[11px] uppercase tracking-wider font-semibold">Filter:</span>
        <a href="/" class="px-2.5 py-1 rounded bg-journal-card dark:bg-night-card border border-journal-borderHover dark:border-night-borderHover text-journal-ink dark:text-night-ink font-semibold">
          All Case Files
        </a>
        <button type="button" class="search-chip px-2.5 py-1 rounded bg-journal-bg dark:bg-night-bg hover:bg-journal-card dark:hover:bg-night-card text-journal-secondary dark:text-night-secondary border border-journal-border dark:border-night-border transition-colors font-mono">
          $MU
        </button>
        <button type="button" class="search-chip px-2.5 py-1 rounded bg-journal-bg dark:bg-night-bg hover:bg-journal-card dark:hover:bg-night-card text-journal-secondary dark:text-night-secondary border border-journal-border dark:border-night-border transition-colors font-mono">
          $NVDA
        </button>
        <button type="button" class="search-chip px-2.5 py-1 rounded bg-journal-bg dark:bg-night-bg hover:bg-journal-card dark:hover:bg-night-card text-journal-secondary dark:text-night-secondary border border-journal-border dark:border-night-border transition-colors">
          Forensic Warnings
        </button>
      </div>

      <span class="text-journal-muted dark:text-night-muted text-[11px]">
        {articles.length} total investigations on record
      </span>
    </div>
  </section>

  <!-- Secondary Articles Grid -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-6" data-pagefind-body>
    {remainingArticles.map((article) => {
      const isWarning = article.data.verdict === 'Forensic Warning';
      const hasVideo = Boolean(article.data.video?.id || article.data.video?.url);

      return (
        <article class="bg-journal-card dark:bg-night-card rounded-xl border border-journal-border dark:border-night-border hover:border-journal-borderHover dark:hover:border-night-borderHover transition-colors p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2.5 text-xs font-sans text-journal-secondary dark:text-night-secondary">
              <span class="font-mono font-bold text-journal-ink dark:text-night-ink px-2 py-0.5 rounded bg-journal-bg dark:bg-night-bg border border-journal-border dark:border-night-border">
                ${article.data.ticker}
              </span>
              <span class={`font-mono uppercase text-[10px] tracking-wider px-2 py-0.5 rounded border font-semibold ${isWarning ? 'bg-amber-50 dark:bg-amber-950/40 text-editorial-crimson dark:text-editorial-crimsonDark border-amber-200 dark:border-amber-900/50' : 'bg-emerald-50 dark:bg-emerald-950/40 text-editorial-emerald dark:text-editorial-emeraldDark border-emerald-200 dark:border-emerald-900/50'}`}>
                {article.data.verdict}
              </span>
              <time class="ml-auto text-journal-muted dark:text-night-muted text-[11px] font-mono">{article.data.publishedAt}</time>
            </div>

            <h3 class="text-xl font-serif font-bold text-journal-ink dark:text-night-ink hover:text-editorial-blue dark:hover:text-editorial-blueDark transition-colors mb-2.5 leading-snug">
              <a href={`/articles/${article.id}`}>
                {article.data.title}
              </a>
            </h3>

            <p class="text-xs font-serif text-journal-secondary dark:text-night-secondary line-clamp-3 leading-relaxed mb-4">
              {article.data.thesis}
            </p>
          </div>

          <div class="pt-3 border-t border-journal-border/50 dark:border-night-border/50 flex items-center justify-between text-xs font-sans">
            <div class="flex items-center gap-3 text-journal-muted dark:text-night-muted font-mono text-[11px]">
              {hasVideo && <span class="text-editorial-emerald dark:text-editorial-emeraldDark">● Video</span>}
              <span>{article.data.citations?.length || 0} Receipts</span>
            </div>

            <a href={`/articles/${article.id}`} class="text-editorial-blue dark:text-editorial-blueDark hover:underline font-medium flex items-center gap-1">
              <span>Read Report</span>
              <span>→</span>
            </a>
          </div>
        </article>
      );
    })}
  </section>
</Layout>

<script>
  // Filter chips click handling
  document.querySelectorAll('.search-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.textContent?.trim().replace('$', '') || '';
      const trigger = document.getElementById('search-trigger');
      trigger?.click();
      setTimeout(() => {
        const input = document.getElementById('search-input') as HTMLInputElement;
        if (input) {
          input.value = text;
          input.dispatchEvent(new Event('input'));
        }
      }, 100);
    });
  });
</script>
