---
interface Citation {
  index: number;
  sourceType: string;
  title: string;
  url: string;
  accession?: string;
  filingDate?: string;
  facts: string[];
  quotes?: string | string[];
}

interface Props {
  citations: Citation[];
}

const { citations = [] } = Astro.props;
const hasCitations = citations.length > 0;
---

<section class="mt-16 pt-10 border-t-2 border-journal-ink/20 dark:border-night-ink/20" id="primary-sources">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
    <h3 class="font-serif text-2xl sm:text-3xl font-bold text-journal-ink dark:text-night-ink tracking-tight">
      Sources & Regulatory Audit
    </h3>
    <span class="text-xs font-sans uppercase tracking-wider text-journal-muted dark:text-night-muted font-medium">
      {citations.length} Audited Source{citations.length === 1 ? '' : 's'}
    </span>
  </div>

  {hasCitations ? (
    <p class="text-sm font-serif italic text-journal-secondary dark:text-night-secondary mb-8 max-w-2xl leading-relaxed">
      All financial statements, valuation models, and consensus estimates in this dispatch are anchored to primary regulatory filings on SEC EDGAR and official market records.
    </p>
  ) : (
    <p class="text-sm font-serif italic text-journal-muted dark:text-night-muted mb-8 max-w-2xl leading-relaxed">
      No verified primary source citations were recorded for this case.
    </p>
  )}

  <ol class="space-y-0 text-left font-sans text-xs">
    {citations.map((cite) => {
      const quoteText = typeof cite.quotes === 'string'
        ? cite.quotes.trim()
        : Array.isArray(cite.quotes) && cite.quotes.length > 0
          ? String(cite.quotes[0] || '').trim()
          : '';
      const hasQuote = quoteText.length > 0 && quoteText !== '""' && quoteText !== "''";

      const cleanFacts = (cite.facts || []).map((f) =>
        f.replace(/,?\s*Provider:\s*[^,)]+/gi, '').replace(/,?\s*As Of:\s*[^,)]+/gi, '').trim()
      );

      return (
        <li
          id={`cite-${cite.index}`}
          class="py-6 border-b border-journal-border/60 dark:border-night-border/60 scroll-mt-24 first:border-t"
        >
          <div class="flex items-start justify-between gap-4 mb-2">
            <div class="flex items-start gap-3">
              <span class="font-serif font-bold text-sm text-editorial-blue dark:text-editorial-blueDark mt-0.5 select-none shrink-0">
                [{cite.index}]
              </span>
              <div>
                <h4 class="font-serif font-bold text-base sm:text-lg text-journal-ink dark:text-night-ink leading-snug">
                  {cite.title}
                </h4>
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs font-sans text-journal-muted dark:text-night-muted mt-1">
                  <span class="font-medium text-journal-secondary dark:text-night-secondary">
                    {cite.sourceType}
                  </span>
                  {cite.accession && (
                    <>
                      <span>•</span>
                      <span class="font-mono text-[11px]">
                        Accession: <span class="text-journal-lead dark:text-night-lead font-semibold">{cite.accession}</span>
                      </span>
                    </>
                  )}
                  {cite.filingDate && (
                    <>
                      <span>•</span>
                      <span>Filed {cite.filingDate}</span>
                    </>
                  )}
                </div>
              </div>
            </div>

            <a
              href={cite.url}
              target="_blank"
              rel="noreferrer"
              class="shrink-0 text-xs font-sans font-medium text-editorial-blue dark:text-editorial-blueDark hover:underline inline-flex items-center gap-1 mt-1"
            >
              <span>Filing Record</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          {hasQuote && (
            <blockquote class="my-3 ml-7 pl-3.5 border-l-2 border-editorial-blue/60 dark:border-editorial-blueDark/60 font-serif italic text-sm text-journal-secondary dark:text-night-secondary bg-journal-canvas/50 dark:bg-night-card/40 py-1.5 rounded-r">
              “{quoteText}”
            </blockquote>
          )}

          {cleanFacts.length > 0 && (
            <div class="mt-3 ml-7">
              <div class="text-[10px] font-sans uppercase tracking-wider text-journal-muted dark:text-night-muted font-semibold mb-1.5">
                Audited Statements & Financial Line Items
              </div>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 text-xs font-mono text-journal-secondary dark:text-night-secondary">
                {cleanFacts.map((fact) => (
                  <li class="flex items-baseline gap-2">
                    <span class="text-journal-muted dark:text-night-muted select-none">•</span>
                    <span>{fact}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      );
    })}
  </ol>
</section>
