---
interface Citation {
  index: number;
  sourceType: string;
  title: string;
  url: string;
  accession?: string;
  filingDate?: string;
  facts: string[];
  quotes?: string;
}

interface Props {
  citations: Citation[];
}

const { citations = [] } = Astro.props;
---

<section class="mt-16 pt-10 border-t border-obsidian-border" id="primary-sources">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div class="w-2.5 h-2.5 rounded-full bg-emerald-audit animate-pulse"></div>
      <h3 class="font-display text-lg font-bold text-text-primary tracking-tight">Primary Sources & Regulatory Receipts</h3>
    </div>
    <span class="text-xs font-mono text-text-muted">{citations.length} Receipts Audited</span>
  </div>

  <p class="text-xs text-text-secondary mb-6 font-mono">
    Every claim in this investigation is bound to an immutable regulatory accession number, consensus dataset, or market feed. Click any receipt to open the filing on SEC EDGAR.
  </p>

  <div class="space-y-4">
    {citations.map((cite) => (
      <div
        id={`cite-${cite.index}`}
        class="p-4 rounded-xl bg-obsidian-card border border-obsidian-border hover:border-emerald-audit/40 transition-all duration-300 scroll-mt-24 group"
      >
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-bold text-emerald-audit bg-emerald-audit/10 px-2 py-0.5 rounded border border-emerald-audit/30">
              [{cite.index}]
            </span>
            <span class="text-xs font-semibold text-text-primary font-display">
              {cite.title}
            </span>
          </div>
          <div class="flex items-center gap-2 text-[11px] font-mono text-text-muted">
            <span class="px-2 py-0.5 rounded bg-obsidian-subtle border border-obsidian-border">
              {cite.sourceType}
            </span>
            {cite.filingDate && <span>{cite.filingDate}</span>}
          </div>
        </div>

        {cite.accession && (
          <div class="mb-2 text-xs font-mono flex items-center gap-2">
            <span class="text-text-muted">SEC Accession:</span>
            <span class="text-emerald-audit font-semibold">{cite.accession}</span>
          </div>
        )}

        {cite.quotes && (
          <div class="my-2.5 text-xs text-text-secondary italic border-l-2 border-emerald-audit/50 pl-3 py-1 bg-obsidian/40 rounded-r">
            "{cite.quotes}"
          </div>
        )}

        {cite.facts && cite.facts.length > 0 && (
          <div class="mt-2 text-xs font-mono text-text-muted">
            <span class="text-[10px] uppercase tracking-wider block mb-1">Audited Facts:</span>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1 text-text-secondary">
              {cite.facts.map((fact) => (
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-audit">✓</span>
                  <span>{fact}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-3 pt-2 border-t border-obsidian-border/50 flex justify-end">
          <a
            href={cite.url}
            target="_blank"
            rel="noreferrer"
            class="text-xs font-mono text-emerald-audit hover:underline flex items-center gap-1.5"
          >
            <span>Verify on Regulatory Authority</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
