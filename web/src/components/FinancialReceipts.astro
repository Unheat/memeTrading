---
interface Citation {
  index: number;
  sourceType: string;
  title: string;
  url: string;
  accession?: string;
  filingDate?: string;
  facts: string[];
  quotes?: string;
}

interface Props {
  citations: Citation[];
}

const { citations = [] } = Astro.props;
const hasCitations = citations.length > 0;
---

<section class="mt-16 pt-10 border-t border-journal-border dark:border-night-border" id="primary-sources">
  <div class="flex items-baseline justify-between mb-4">
    <h3 class="font-serif text-xl font-bold text-journal-ink dark:text-night-ink tracking-tight">
      References & Regulatory Filings
    </h3>
    <span class="text-xs font-sans text-journal-muted dark:text-night-muted">
      {citations.length} primary source{citations.length === 1 ? '' : 's'} audited
    </span>
  </div>

  {hasCitations ? (
    <p class="text-xs text-journal-secondary dark:text-night-secondary mb-8 font-sans max-w-2xl leading-relaxed">
      Every assertion in this report is anchored to verifiable regulatory filings on SEC EDGAR, consensus databases, or market execution venues.
    </p>
  ) : (
    <p class="text-xs text-journal-muted dark:text-night-muted mb-8 font-sans max-w-2xl leading-relaxed">
      No verified primary source citations were recorded for this case.
    </p>
  )}

  <ol class="space-y-4 font-sans text-xs">
    {citations.map((cite) => (
      <li
        id={`cite-${cite.index}`}
        class="p-4 rounded-lg bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border hover:border-journal-borderHover dark:hover:border-night-borderHover transition-colors scroll-mt-24 text-left"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1.5">
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-xs font-bold text-editorial-blue dark:text-editorial-blueDark">
              [{cite.index}]
            </span>
            <span class="font-serif font-semibold text-journal-ink dark:text-night-ink text-sm">
              {cite.title}
            </span>
          </div>
          <div class="flex items-center gap-2 text-[11px] text-journal-muted dark:text-night-muted font-mono">
            <span class="px-1.5 py-0.5 rounded bg-journal-bg dark:bg-night-bg border border-journal-border dark:border-night-border">
              {cite.sourceType}
            </span>
            {cite.filingDate && <span>{cite.filingDate}</span>}
          </div>
        </div>

        {cite.accession && (
          <div class="mb-2 text-xs font-mono text-journal-muted dark:text-night-muted flex items-center gap-2">
            <span>SEC Accession:</span>
            <span class="font-semibold text-journal-secondary dark:text-night-secondary">{cite.accession}</span>
          </div>
        )}

        {cite.quotes && (
          <blockquote class="my-2.5 text-xs text-journal-secondary dark:text-night-secondary font-serif italic border-l-2 border-editorial-blue/60 dark:border-editorial-blueDark/60 pl-3 py-1 bg-journal-bg/50 dark:bg-night-bg/50 rounded-r">
            "{cite.quotes}"
          </blockquote>
        )}

        {cite.facts && cite.facts.length > 0 && (
          <div class="mt-2 text-xs text-journal-muted dark:text-night-muted">
            <span class="text-[10px] font-semibold uppercase tracking-wider block mb-1">Audited Data Points:</span>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1 font-mono text-journal-secondary dark:text-night-secondary">
              {cite.facts.map((fact) => (
                <li class="flex items-center gap-1.5">
                  <span class="text-editorial-emerald dark:text-editorial-emeraldDark">✓</span>
                  <span>{fact}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-3 pt-2 border-t border-journal-border/40 dark:border-night-border/40 flex justify-end">
          <a
            href={cite.url}
            target="_blank"
            rel="noreferrer"
            class="text-xs text-editorial-blue dark:text-editorial-blueDark hover:underline flex items-center gap-1 font-medium"
          >
            <span>Open SEC EDGAR Filing</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </li>
    ))}
  </ol>
</section>
