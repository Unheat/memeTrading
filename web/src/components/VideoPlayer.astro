---
interface VideoConfig {
  provider: 'youtube' | 'r2' | 'local';
  id?: string;
  url?: string;
  aspectRatio?: '9:16' | '16:9';
  title?: string;
}

interface Props {
  video?: VideoConfig;
  ticker?: string;
  caseId?: string;
}

const { video, ticker = "SEC", caseId = "" } = Astro.props;
const isVertical = video?.aspectRatio !== '16:9';
---

<figure class="w-full my-8 flex flex-col items-center">
  {video && (video.id || video.url) ? (
    <div class={`w-full ${isVertical ? 'max-w-xs sm:max-w-sm' : 'max-w-3xl'} bg-journal-card dark:bg-night-card rounded-xl border border-journal-border dark:border-night-border p-2 sm:p-2.5 shadow-md overflow-hidden transition-colors`}>
      <!-- Editorial Eyebrow -->
      <div class="flex items-center justify-between px-2 py-1.5 mb-1.5 border-b border-journal-border/50 dark:border-night-border/50 text-xs font-sans text-journal-muted dark:text-night-muted">
        <span class="font-serif font-semibold text-journal-lead dark:text-night-lead">
          Executive Video Briefing
        </span>
        <span class="font-mono text-[10px] tracking-wider uppercase px-1.5 py-0.5 rounded bg-journal-bg dark:bg-night-bg border border-journal-border dark:border-night-border">
          ${ticker}
        </span>
      </div>

      <!-- Video Container -->
      <div class={`relative w-full ${isVertical ? 'aspect-[9/16]' : 'aspect-video'} bg-black rounded-lg overflow-hidden shadow-inner`}>
        {video.provider === 'youtube' && video.id ? (
          <iframe
            class="w-full h-full"
            src={`https://www.youtube.com/embed/${video.id}?rel=0&modestbranding=1&playsinline=1`}
            title={video.title || `${ticker} Executive Video Briefing`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        ) : video.url ? (
          <video
            class="w-full h-full object-cover"
            controls
            playsinline
            preload="metadata"
            src={video.url}
          >
            Your browser does not support the video tag.
          </video>
        ) : null}
      </div>

      <!-- Caption -->
      <figcaption class="px-2 pt-2 text-center text-[11px] font-sans text-journal-muted dark:text-night-muted">
        Companion character dialogue synthesizing audited filing anomalies and consensus disconnects.
      </figcaption>
    </div>
  ) : null}
</figure>
