---
interface Props {
  activeNav?: string;
}

const { activeNav = "articles" } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-obsidian-border bg-obsidian/85 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-emerald-audit/20 to-cyan-consensus/20 border border-emerald-audit/40 flex items-center justify-center shadow-glowEmerald group-hover:border-emerald-audit transition-all">
        <span class="font-mono text-emerald-audit font-extrabold text-base">MT</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-display font-bold text-base tracking-tight text-text-primary group-hover:text-emerald-audit transition-colors">MEMETRADING</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-audit/10 text-emerald-audit border border-emerald-audit/30 uppercase tracking-widest font-semibold">Forensic</span>
        </div>
        <p class="text-[11px] text-text-muted font-mono hidden sm:block">Institutional Fusion & Video Reels</p>
      </div>
    </a>

    <!-- Navigation & Search Trigger -->
    <div class="flex items-center gap-3 sm:gap-6">
      <!-- Search Button -->
      <button
        id="search-trigger"
        type="button"
        class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg bg-obsidian-card border border-obsidian-border hover:border-emerald-audit/50 hover:bg-obsidian-subtle text-text-secondary text-xs transition-all shadow-sm group"
        aria-label="Search articles"
      >
        <svg class="w-4 h-4 text-text-muted group-hover:text-emerald-audit transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden md:inline">Search filings, tickers...</span>
        <span class="md:hidden">Search</span>
        <kbd class="hidden sm:inline-flex items-center gap-0.5 text-[10px] font-mono bg-obsidian px-1.5 py-0.5 rounded border border-obsidian-border text-text-muted">
          ⌘K
        </kbd>
      </button>

      <nav class="hidden sm:flex items-center gap-5 text-xs font-medium">
        <a href="/" class={`hover:text-text-primary transition-colors ${activeNav === 'articles' ? 'text-emerald-audit font-semibold' : 'text-text-secondary'}`}>
          Investigations
        </a>
        <a href="https://github.com/UnHeat/memeTrading" target="_blank" rel="noreferrer" class="text-text-secondary hover:text-text-primary transition-colors flex items-center gap-1.5">
          <span>GitHub</span>
          <svg class="w-3 h-3 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>
    </div>
  </div>
</header>
