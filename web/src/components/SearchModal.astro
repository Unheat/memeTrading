---
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm flex items-start justify-center p-4 sm:pt-20"
  role="dialog"
  aria-modal="true"
>
  <div class="w-full max-w-2xl bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] animate-in fade-in zoom-in-95 duration-150">
    <!-- Search Bar Input Header -->
    <div class="p-4 border-b border-journal-border/70 dark:border-night-border/70 flex items-center gap-3 bg-journal-bg/60 dark:bg-night-bg/60">
      <svg class="w-4 h-4 text-editorial-blue dark:text-editorial-blueDark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search regulatory filings, tickers ($MU, $NVDA), or forensic accounting anomalies..."
        class="w-full bg-transparent text-sm text-journal-ink dark:text-night-ink placeholder:text-journal-muted dark:placeholder:text-night-muted focus:outline-none font-sans"
        autocomplete="off"
      />
      <button id="search-close-btn" class="p-1 text-journal-muted dark:text-night-muted hover:text-journal-ink dark:hover:text-night-ink text-xs font-mono px-2 py-0.5 rounded bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border">
        ESC
      </button>
    </div>

    <!-- Quick Filter Ticker Chips -->
    <div class="px-4 py-2 bg-journal-bg/40 dark:bg-night-bg/40 border-b border-journal-border/50 dark:border-night-border/50 flex items-center gap-2 overflow-x-auto text-xs font-sans">
      <span class="text-journal-muted dark:text-night-muted text-[11px]">Quick Filters:</span>
      <button class="filter-chip px-2.5 py-0.5 rounded bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border hover:border-editorial-blue text-journal-secondary dark:text-night-secondary hover:text-journal-ink dark:hover:text-night-ink transition-colors font-mono text-xs" data-filter="MU">
        $MU
      </button>
      <button class="filter-chip px-2.5 py-0.5 rounded bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border hover:border-editorial-blue text-journal-secondary dark:text-night-secondary hover:text-journal-ink dark:hover:text-night-ink transition-colors font-mono text-xs" data-filter="NVDA">
        $NVDA
      </button>
      <button class="filter-chip px-2.5 py-0.5 rounded bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border hover:border-editorial-blue text-journal-secondary dark:text-night-secondary hover:text-journal-ink dark:hover:text-night-ink transition-colors" data-filter="Forensic Warning">
        Forensic Warnings
      </button>
      <button class="filter-chip px-2.5 py-0.5 rounded bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border hover:border-editorial-blue text-journal-secondary dark:text-night-secondary hover:text-journal-ink dark:hover:text-night-ink transition-colors" data-filter="Reverse DCF">
        Reverse DCF
      </button>
    </div>

    <!-- Results Container -->
    <div id="search-results" class="p-4 overflow-y-auto flex-1 space-y-3">
      <div id="search-initial-state" class="text-center py-10 text-journal-muted dark:text-night-muted text-xs font-sans">
        Type to search across forensic research dispatches, audited SEC filings, and video reels.
      </div>
    </div>

    <!-- Footer Shortcuts -->
    <div class="px-4 py-2 border-t border-journal-border/50 dark:border-night-border/50 bg-journal-bg/30 dark:bg-night-bg/30 text-[11px] font-sans text-journal-muted dark:text-night-muted flex items-center justify-between">
      <span>Pagefind In-Browser Search Engine</span>
      <span class="font-mono text-[10px]">↑↓ Navigate • ↵ Select • ESC Close</span>
    </div>
  </div>
</div>

<script>
  let pagefind: any = null;

  async function loadPagefind() {
    if (!pagefind) {
      try {
        const dynamicImport = new Function('p', 'return import(p)');
        pagefind = await dynamicImport('/pagefind/pagefind.js');
        await pagefind.init();
      } catch (err) {
        console.warn('Pagefind is available in production build after `pagefind --site dist`.', err);
      }
    }
  }

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results');
  const triggerBtn = document.getElementById('search-trigger');
  const closeBtn = document.getElementById('search-close-btn');

  function openSearch() {
    modal?.classList.remove('hidden');
    input?.focus();
    loadPagefind();
  }

  function closeSearch() {
    modal?.classList.add('hidden');
    if (input) input.value = '';
  }

  triggerBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      modal?.classList.contains('hidden') ? openSearch() : closeSearch();
    }
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  document.querySelectorAll('.filter-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const val = chip.getAttribute('data-filter') || '';
      if (input) {
        input.value = val;
        handleSearch(val);
      }
    });
  });

  let debounceTimer: number;
  input?.addEventListener('input', (e) => {
    clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(() => {
      handleSearch((e.target as HTMLInputElement).value);
    }, 150);
  });

  async function handleSearch(query: string) {
    if (!resultsContainer) return;
    const cleanQuery = query.trim();

    if (!cleanQuery) {
      resultsContainer.innerHTML = `
        <div class="text-center py-10 text-journal-muted dark:text-night-muted text-xs font-sans">
          Type to search across forensic research dispatches, audited SEC filings, and video reels.
        </div>
      `;
      return;
    }

    if (pagefind) {
      try {
        const search = await pagefind.search(cleanQuery);
        if (!search.results.length) {
          resultsContainer.innerHTML = `
            <div class="text-center py-10 text-journal-muted dark:text-night-muted text-xs font-sans">
              No investigations matched "${cleanQuery}". Try another ticker or thesis query.
            </div>
          `;
          return;
        }

        const dataPromises = search.results.slice(0, 6).map((r: any) => r.data());
        const items = await Promise.all(dataPromises);

        resultsContainer.innerHTML = items.map((item: any) => `
          <a href="${item.url}" class="block p-3 rounded-lg bg-journal-card dark:bg-night-card hover:bg-journal-bg dark:hover:bg-night-bg border border-journal-border dark:border-night-border transition-colors group text-left">
            <div class="flex items-center justify-between mb-1">
              <h4 class="text-sm font-serif font-bold text-journal-ink dark:text-night-ink group-hover:text-editorial-blue dark:group-hover:text-editorial-blueDark transition-colors">
                ${item.meta.title || item.url}
              </h4>
              <span class="text-[11px] font-sans text-editorial-blue dark:text-editorial-blueDark">Read →</span>
            </div>
            <p class="text-xs font-sans text-journal-secondary dark:text-night-secondary line-clamp-2">${item.excerpt}</p>
          </a>
        `).join('');
      } catch (err) {
        console.error('Pagefind search error', err);
      }
    } else {
      resultsContainer.innerHTML = `
        <div class="p-3 text-xs font-sans text-journal-muted dark:text-night-muted bg-journal-bg/50 dark:bg-night-bg/50 rounded">
          Search index available upon static compilation (<code>npm run build</code>).
          <div class="mt-1">Direct query: <span class="font-semibold text-journal-ink dark:text-night-ink">${cleanQuery}</span></div>
        </div>
      `;
    }
  }
</script>
