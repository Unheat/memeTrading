---
interface Citation {
  index: number;
  sourceType: string;
  title: string;
  url: string;
  accession?: string;
  filingDate?: string;
  facts: string[];
  quotes?: string;
}

interface Props {
  citations: Citation[];
}

const { citations } = Astro.props;
---

<!-- Citation Data Bag (Serialized for Client-Side Hydration) -->
<div id="citation-data-store" data-citations={JSON.stringify(citations)} class="hidden"></div>

<!-- Desktop Popover Floating Card -->
<div
  id="citation-floating-popover"
  class="fixed hidden z-50 max-w-sm w-96 bg-obsidian-card/95 backdrop-blur-xl border border-obsidian-border rounded-xl p-4 shadow-2xl transition-all duration-200 pointer-events-auto"
  role="tooltip"
>
  <div class="flex items-center justify-between gap-2 mb-2">
    <span id="popover-source-type" class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-audit/15 text-emerald-audit border border-emerald-audit/30">
      SEC Filing
    </span>
    <span id="popover-date" class="text-[11px] font-mono text-text-muted"></span>
  </div>

  <h5 id="popover-title" class="text-xs font-semibold text-text-primary font-display mb-2 leading-snug"></h5>

  <!-- Accession Receipt -->
  <div id="popover-accession-wrap" class="mb-2.5 flex items-center justify-between text-[11px] font-mono bg-obsidian/80 px-2.5 py-1 rounded border border-obsidian-border/80">
    <span class="text-text-muted">Accession:</span>
    <a id="popover-accession-link" href="#" target="_blank" rel="noreferrer" class="text-emerald-audit hover:underline truncate max-w-[180px]"></a>
  </div>

  <!-- Verbatim Excerpt -->
  <div id="popover-quote-wrap" class="mb-2.5 text-xs text-text-secondary italic border-l-2 border-emerald-audit/60 pl-2.5 py-0.5 bg-obsidian-subtle/40 rounded-r">
    "<span id="popover-quote"></span>"
  </div>

  <!-- Audited Facts -->
  <div id="popover-facts-wrap" class="mb-3">
    <div class="text-[10px] font-mono uppercase text-text-muted mb-1">Audited Facts:</div>
    <ul id="popover-facts-list" class="space-y-0.5 text-xs font-mono text-text-secondary"></ul>
  </div>

  <!-- Footer Actions -->
  <div class="flex items-center justify-between pt-2 border-t border-obsidian-border/60 text-xs">
    <a id="popover-primary-link" href="#" target="_blank" rel="noreferrer" class="text-emerald-audit hover:text-emerald-300 font-medium flex items-center gap-1">
      <span>Open SEC.gov</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
    <button id="popover-jump-btn" type="button" class="text-text-muted hover:text-text-primary transition-colors text-[11px] font-mono">
      Scroll to receipt ↓
    </button>
  </div>
</div>

<!-- Mobile Drawer Modal -->
<div id="citation-mobile-drawer" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm flex flex-col justify-end sm:hidden">
  <div class="w-full bg-obsidian-card border-t border-obsidian-border rounded-t-2xl p-5 max-h-[80vh] overflow-y-auto">
    <div class="w-12 h-1 bg-obsidian-border rounded-full mx-auto mb-4"></div>
    <div class="flex items-center justify-between mb-3">
      <span id="mobile-source-type" class="text-xs font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-emerald-audit/15 text-emerald-audit border border-emerald-audit/30"></span>
      <button id="mobile-close-btn" class="p-1 text-text-muted hover:text-text-primary">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <h4 id="mobile-title" class="text-sm font-semibold text-text-primary font-display mb-2"></h4>
    <p id="mobile-quote" class="text-xs text-text-secondary italic border-l-2 border-emerald-audit/60 pl-3 py-1 mb-3 bg-obsidian-subtle/40 rounded-r"></p>
    <div class="mb-4">
      <div class="text-[11px] font-mono uppercase text-text-muted mb-1">Audited Facts:</div>
      <ul id="mobile-facts-list" class="space-y-1 text-xs font-mono text-text-secondary"></ul>
    </div>
    <a id="mobile-primary-link" href="#" target="_blank" rel="noreferrer" class="w-full py-2.5 rounded-lg bg-emerald-audit text-black font-semibold text-center block text-xs">
      Open Primary Regulatory Filing
    </a>
  </div>
</div>

<script>
  // Client-side citation enhancement
  document.addEventListener('DOMContentLoaded', () => {
    const dataStore = document.getElementById('citation-data-store');
    if (!dataStore) return;

    let citations: any[] = [];
    try {
      citations = JSON.parse(dataStore.getAttribute('data-citations') || '[]');
    } catch (e) {
      console.error('Failed to parse citations', e);
      return;
    }

    const citationMap = new Map<number, any>();
    citations.forEach(c => citationMap.set(Number(c.index), c));

    const popover = document.getElementById('citation-floating-popover');
    const drawer = document.getElementById('citation-mobile-drawer');
    const isMobile = () => window.innerWidth < 640;

    let activeCitationIndex: number | null = null;
    let hideTimeout: number | null = null;

    function populatePopover(citation: any) {
      const typeEl = document.getElementById('popover-source-type');
      const dateEl = document.getElementById('popover-date');
      const titleEl = document.getElementById('popover-title');
      const accLink = document.getElementById('popover-accession-link') as HTMLAnchorElement;
      const quoteEl = document.getElementById('popover-quote');
      const quoteWrap = document.getElementById('popover-quote-wrap');
      const factsList = document.getElementById('popover-facts-list');
      const primaryLink = document.getElementById('popover-primary-link') as HTMLAnchorElement;
      const jumpBtn = document.getElementById('popover-jump-btn');

      if (typeEl) typeEl.textContent = citation.sourceType || 'SEC Filing';
      if (dateEl) dateEl.textContent = citation.filingDate || '';
      if (titleEl) titleEl.textContent = citation.title || 'Regulatory Receipt';
      if (accLink) {
        accLink.textContent = citation.accession || 'View Filing';
        accLink.href = citation.url || '#';
      }
      if (quoteEl && quoteWrap) {
        if (citation.quotes) {
          quoteEl.textContent = citation.quotes;
          quoteWrap.style.display = 'block';
        } else {
          quoteWrap.style.display = 'none';
        }
      }
      if (factsList) {
        factsList.innerHTML = '';
        (citation.facts || []).forEach((fact: string) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-1.5';
          li.innerHTML = `<span class="text-emerald-audit text-[10px]">●</span> <span>${fact}</span>`;
          factsList.appendChild(li);
        });
      }
      if (primaryLink) primaryLink.href = citation.url || '#';
      if (jumpBtn) {
        jumpBtn.onclick = () => {
          const target = document.getElementById(`cite-${citation.index}`);
          if (target) {
            popover?.classList.add('hidden');
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            target.classList.add('ring-2', 'ring-emerald-audit', 'bg-emerald-audit/10');
            setTimeout(() => {
              target.classList.remove('ring-2', 'ring-emerald-audit', 'bg-emerald-audit/10');
            }, 2500);
          }
        };
      }
    }

    function showPopoverAtElement(el: HTMLElement, citation: any) {
      if (!popover) return;
      if (hideTimeout) clearTimeout(hideTimeout);
      activeCitationIndex = citation.index;
      populatePopover(citation);

      popover.classList.remove('hidden');
      const rect = el.getBoundingClientRect();
      const popoverWidth = 384; // 24rem
      const popoverHeight = popover.offsetHeight || 260;

      let top = rect.bottom + 8;
      let left = rect.left + rect.width / 2 - popoverWidth / 2;

      // Flip above if too close to bottom
      if (top + popoverHeight > window.innerHeight - 20) {
        top = rect.top - popoverHeight - 8;
      }
      // Bound left/right
      if (left < 16) left = 16;
      if (left + popoverWidth > window.innerWidth - 16) {
        left = window.innerWidth - popoverWidth - 16;
      }

      popover.style.top = `${top}px`;
      popover.style.left = `${left}px`;
    }

    function openMobileDrawer(citation: any) {
      if (!drawer) return;
      const typeEl = document.getElementById('mobile-source-type');
      const titleEl = document.getElementById('mobile-title');
      const quoteEl = document.getElementById('mobile-quote');
      const factsList = document.getElementById('mobile-facts-list');
      const primaryLink = document.getElementById('mobile-primary-link') as HTMLAnchorElement;

      if (typeEl) typeEl.textContent = citation.sourceType || 'SEC Filing';
      if (titleEl) titleEl.textContent = citation.title || 'Regulatory Receipt';
      if (quoteEl) quoteEl.textContent = citation.quotes || 'No excerpt available';
      if (factsList) {
        factsList.innerHTML = '';
        (citation.facts || []).forEach((f: string) => {
          const li = document.createElement('li');
          li.textContent = `• ${f}`;
          factsList.appendChild(li);
        });
      }
      if (primaryLink) primaryLink.href = citation.url || '#';

      drawer.classList.remove('hidden');
    }

    // Scan article content for citation markers [1], [2], etc.
    const articleContainer = document.getElementById('article-content');
    if (articleContainer) {
      // Find text nodes with bracketed numbers
      const walker = document.createTreeWalker(articleContainer, NodeFilter.SHOW_TEXT);
      const nodesToReplace: Text[] = [];

      let node: Node | null;
      while ((node = walker.nextNode())) {
        if (/\[\d+\]/.test(node.nodeValue || '')) {
          nodesToReplace.push(node as Text);
        }
      }

      nodesToReplace.forEach(textNode => {
        const text = textNode.nodeValue || '';
        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        const regex = /\[(\d+)\]/g;
        let match: RegExpExecArray | null;

        while ((match = regex.exec(text)) !== null) {
          // Preceding text
          if (match.index > lastIndex) {
            fragment.appendChild(document.createTextNode(text.substring(lastIndex, match.index)));
          }

          const citeIdx = parseInt(match[1], 10);
          const citation = citationMap.get(citeIdx);

          const pill = document.createElement('button');
          pill.type = 'button';
          pill.className = 'citation-pill inline-flex items-center justify-center font-mono text-[11px] font-semibold px-1.5 py-0.5 mx-0.5 rounded bg-emerald-audit/10 text-emerald-audit border border-emerald-audit/30 hover:bg-emerald-audit/25 hover:border-emerald-audit transition-all cursor-pointer select-none';
          pill.setAttribute('data-cite-index', String(citeIdx));
          pill.textContent = `[${citeIdx}]`;

          pill.addEventListener('mouseenter', () => {
            if (!isMobile() && citation) {
              showPopoverAtElement(pill, citation);
            }
          });

          pill.addEventListener('mouseleave', () => {
            if (!isMobile()) {
              hideTimeout = window.setTimeout(() => {
                popover?.classList.add('hidden');
              }, 300);
            }
          });

          pill.addEventListener('click', (e) => {
            e.preventDefault();
            if (citation) {
              if (isMobile()) {
                openMobileDrawer(citation);
              } else {
                showPopoverAtElement(pill, citation);
              }
            }
          });

          fragment.appendChild(pill);
          lastIndex = regex.lastIndex;
        }

        if (lastIndex < text.length) {
          fragment.appendChild(document.createTextNode(text.substring(lastIndex)));
        }

        textNode.parentNode?.replaceChild(fragment, textNode);
      });
    }

    // Keep popover alive while hovering over it
    popover?.addEventListener('mouseenter', () => {
      if (hideTimeout) clearTimeout(hideTimeout);
    });
    popover?.addEventListener('mouseleave', () => {
      hideTimeout = window.setTimeout(() => {
        popover?.classList.add('hidden');
      }, 300);
    });

    // Close mobile drawer
    document.getElementById('mobile-close-btn')?.addEventListener('click', () => {
      drawer?.classList.add('hidden');
    });
    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.add('hidden');
    });

    // Global escape to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        popover?.classList.add('hidden');
        drawer?.classList.add('hidden');
      }
    });
  });
</script>
