---
interface Citation {
  index: number;
  sourceType: string;
  title: string;
  url: string;
  accession?: string;
  filingDate?: string;
  facts: string[];
  quotes?: string;
}

interface Props {
  citations: Citation[];
}

const { citations } = Astro.props;
---

<!-- Citation Data Bag (Serialized for Client-Side Hydration) -->
<div id="citation-data-store" data-citations={JSON.stringify(citations)} class="hidden"></div>

<!-- Wikipedia-Style Floating Preview Tooltip -->
<div
  id="citation-floating-popover"
  class="fixed hidden z-50 max-w-sm w-80 sm:w-96 bg-journal-card dark:bg-night-card border border-journal-border dark:border-night-border rounded-lg p-4 shadow-xl transition-all duration-150 pointer-events-auto text-left"
  role="tooltip"
>
  <div class="flex items-center justify-between gap-2 mb-2 pb-1.5 border-b border-journal-border/50 dark:border-night-border/50">
    <span id="popover-source-type" class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-journal-bg dark:bg-night-bg text-editorial-blue dark:text-editorial-blueDark border border-journal-border dark:border-night-border">
      SEC Filing
    </span>
    <span id="popover-date" class="text-[11px] font-sans text-journal-muted dark:text-night-muted"></span>
  </div>

  <h5 id="popover-title" class="text-xs font-semibold text-journal-ink dark:text-night-ink font-serif mb-2 leading-snug"></h5>

  <!-- Accession Receipt -->
  <div id="popover-accession-wrap" class="mb-2 flex items-center justify-between text-[11px] font-mono bg-journal-bg dark:bg-night-bg px-2.5 py-1 rounded border border-journal-border/70 dark:border-night-border/70">
    <span class="text-journal-muted dark:text-night-muted">Accession:</span>
    <a id="popover-accession-link" href="#" target="_blank" rel="noreferrer" class="text-editorial-blue dark:text-editorial-blueDark hover:underline truncate max-w-[180px]"></a>
  </div>

  <!-- Verbatim Excerpt -->
  <div id="popover-quote-wrap" class="mb-2 text-xs text-journal-secondary dark:text-night-secondary font-serif italic border-l-2 border-editorial-blue/60 dark:border-editorial-blueDark/60 pl-2.5 py-0.5 bg-journal-bg/50 dark:bg-night-bg/50 rounded-r">
    "<span id="popover-quote"></span>"
  </div>

  <!-- Audited Facts -->
  <div id="popover-facts-wrap" class="mb-3">
    <div class="text-[10px] font-sans uppercase text-journal-muted dark:text-night-muted mb-1 font-semibold tracking-wider">Audited Data Points:</div>
    <ul id="popover-facts-list" class="space-y-0.5 text-xs font-mono text-journal-secondary dark:text-night-secondary"></ul>
  </div>

  <!-- Footer Actions -->
  <div class="flex items-center justify-between pt-2 border-t border-journal-border/50 dark:border-night-border/50 text-xs font-sans">
    <a id="popover-primary-link" href="#" target="_blank" rel="noreferrer" class="text-editorial-blue dark:text-editorial-blueDark hover:underline font-medium flex items-center gap-1">
      <span>Open Official Source</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
    <button id="popover-jump-btn" type="button" class="text-journal-muted dark:text-night-muted hover:text-journal-ink dark:hover:text-night-ink transition-colors text-[11px]">
      Jump to footnote ↓
    </button>
  </div>
</div>

<!-- Mobile Drawer Modal -->
<div id="citation-mobile-drawer" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex flex-col justify-end sm:hidden">
  <div class="w-full bg-journal-card dark:bg-night-card border-t border-journal-border dark:border-night-border rounded-t-2xl p-5 max-h-[80vh] overflow-y-auto">
    <div class="w-12 h-1 bg-journal-border dark:bg-night-border rounded-full mx-auto mb-4"></div>
    <div class="flex items-center justify-between mb-3">
      <span id="mobile-source-type" class="text-xs font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-journal-bg dark:bg-night-bg text-editorial-blue dark:text-editorial-blueDark border border-journal-border dark:border-night-border"></span>
      <button id="mobile-close-btn" class="p-1 text-journal-muted hover:text-journal-ink dark:hover:text-night-ink">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <h4 id="mobile-title" class="text-sm font-semibold text-journal-ink dark:text-night-ink font-serif mb-2"></h4>
    <p id="mobile-quote" class="text-xs text-journal-secondary dark:text-night-secondary font-serif italic border-l-2 border-editorial-blue/60 pl-3 py-1 mb-3 bg-journal-bg/50 dark:bg-night-bg/50 rounded-r"></p>
    <div class="mb-4">
      <div class="text-[11px] font-sans uppercase text-journal-muted dark:text-night-muted mb-1 font-semibold">Audited Facts:</div>
      <ul id="mobile-facts-list" class="space-y-1 text-xs font-mono text-journal-secondary dark:text-night-secondary"></ul>
    </div>
    <a id="mobile-primary-link" href="#" target="_blank" rel="noreferrer" class="w-full py-2.5 rounded-lg bg-editorial-blue dark:bg-editorial-blueDark text-white dark:text-black font-medium text-center block text-xs">
      Open Official Source
    </a>
  </div>
</div>

<script>
  // Wikipedia-style citation enhancement
  document.addEventListener('DOMContentLoaded', () => {
    const dataStore = document.getElementById('citation-data-store');
    if (!dataStore) return;

    let citations: any[] = [];
    try {
      citations = JSON.parse(dataStore.getAttribute('data-citations') || '[]');
    } catch (e) {
      console.error('Failed to parse citations', e);
      return;
    }

    const citationMap = new Map<number, any>();
    citations.forEach(c => citationMap.set(Number(c.index), c));

    const popover = document.getElementById('citation-floating-popover');
    const drawer = document.getElementById('citation-mobile-drawer');
    const isMobile = () => window.innerWidth < 640;

    let activeCitationIndex: number | null = null;
    let hideTimeout: number | null = null;

    function populatePopover(citation: any) {
      const typeEl = document.getElementById('popover-source-type');
      const dateEl = document.getElementById('popover-date');
      const titleEl = document.getElementById('popover-title');
      const accLink = document.getElementById('popover-accession-link') as HTMLAnchorElement;
      const quoteEl = document.getElementById('popover-quote');
      const quoteWrap = document.getElementById('popover-quote-wrap');
      const factsList = document.getElementById('popover-facts-list');
      const primaryLink = document.getElementById('popover-primary-link') as HTMLAnchorElement;
      const jumpBtn = document.getElementById('popover-jump-btn');

      if (typeEl) typeEl.textContent = citation.sourceType || 'SEC Filing';
      if (dateEl) dateEl.textContent = citation.filingDate || '';
      if (titleEl) titleEl.textContent = citation.title || 'Regulatory Filing Reference';
      if (accLink) {
        accLink.textContent = citation.accession || 'View Filing';
        accLink.href = citation.url || '#';
      }
      if (quoteEl && quoteWrap) {
        if (citation.quotes) {
          quoteEl.textContent = citation.quotes;
          quoteWrap.style.display = 'block';
        } else {
          quoteWrap.style.display = 'none';
        }
      }
      if (factsList) {
        factsList.innerHTML = '';
        (citation.facts || []).forEach((fact: string) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-1.5';
          li.innerHTML = `<span class="text-editorial-blue dark:text-editorial-blueDark text-[10px]">●</span> <span>${fact}</span>`;
          factsList.appendChild(li);
        });
      }
      if (primaryLink) primaryLink.href = citation.url || '#';
      if (jumpBtn) {
        jumpBtn.onclick = () => {
          const target = document.getElementById(`cite-${citation.index}`);
          if (target) {
            popover?.classList.add('hidden');
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            target.classList.add('bg-amber-100/60', 'dark:bg-amber-900/30');
            setTimeout(() => {
              target.classList.remove('bg-amber-100/60', 'dark:bg-amber-900/30');
            }, 2500);
          }
        };
      }
    }

    function showPopoverAtElement(el: HTMLElement, citation: any) {
      if (!popover) return;
      if (hideTimeout) clearTimeout(hideTimeout);
      activeCitationIndex = citation.index;
      populatePopover(citation);

      popover.classList.remove('hidden');
      const rect = el.getBoundingClientRect();
      const popoverWidth = 340;
      const popoverHeight = popover.offsetHeight || 220;

      let top = rect.bottom + 6;
      let left = rect.left + rect.width / 2 - popoverWidth / 2;

      // Flip above if near bottom
      if (top + popoverHeight > window.innerHeight - 16) {
        top = rect.top - popoverHeight - 6;
      }
      // Keep within viewport horizontally
      if (left < 16) left = 16;
      if (left + popoverWidth > window.innerWidth - 16) {
        left = window.innerWidth - popoverWidth - 16;
      }

      popover.style.top = `${top}px`;
      popover.style.left = `${left}px`;
    }

    function openMobileDrawer(citation: any) {
      if (!drawer) return;
      const typeEl = document.getElementById('mobile-source-type');
      const titleEl = document.getElementById('mobile-title');
      const quoteEl = document.getElementById('mobile-quote');
      const factsList = document.getElementById('mobile-facts-list');
      const primaryLink = document.getElementById('mobile-primary-link') as HTMLAnchorElement;

      if (typeEl) typeEl.textContent = citation.sourceType || 'SEC Filing';
      if (titleEl) titleEl.textContent = citation.title || 'Regulatory Filing Reference';
      if (quoteEl) quoteEl.textContent = citation.quotes || 'No excerpt available';
      if (factsList) {
        factsList.innerHTML = '';
        (citation.facts || []).forEach((f: string) => {
          const li = document.createElement('li');
          li.textContent = `• ${f}`;
          factsList.appendChild(li);
        });
      }
      if (primaryLink) primaryLink.href = citation.url || '#';

      drawer.classList.remove('hidden');
    }

    // Scan article text nodes and transform [1] into Wikipedia-style <sup>[1]</sup> links
    const articleContainer = document.getElementById('article-content');
    if (articleContainer) {
      const walker = document.createTreeWalker(articleContainer, NodeFilter.SHOW_TEXT);
      const nodesToReplace: Text[] = [];

      let node: Node | null;
      while ((node = walker.nextNode())) {
        if (/\[\d+\]/.test(node.nodeValue || '')) {
          nodesToReplace.push(node as Text);
        }
      }

      nodesToReplace.forEach(textNode => {
        const text = textNode.nodeValue || '';
        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        const regex = /\[(\d+)\]/g;
        let match: RegExpExecArray | null;

        while ((match = regex.exec(text)) !== null) {
          if (match.index > lastIndex) {
            fragment.appendChild(document.createTextNode(text.substring(lastIndex, match.index)));
          }

          const citeIdx = parseInt(match[1], 10);
          const citation = citationMap.get(citeIdx);

          // Wikipedia-style superscript citation reference: <sup><a href="#cite-X">[X]</a></sup>
          const sup = document.createElement('sup');
          sup.className = 'citation-ref inline-block align-super font-sans text-[11px] font-semibold leading-none mx-0.5 select-none';

          const link = document.createElement('a');
          link.href = `#cite-${citeIdx}`;
          link.className = 'text-editorial-blue dark:text-editorial-blueDark hover:underline cursor-pointer';
          link.setAttribute('data-cite-index', String(citeIdx));
          link.textContent = `[${citeIdx}]`;

          link.addEventListener('mouseenter', () => {
            if (!isMobile() && citation) {
              showPopoverAtElement(link, citation);
            }
          });

          link.addEventListener('mouseleave', () => {
            if (!isMobile()) {
              hideTimeout = window.setTimeout(() => {
                popover?.classList.add('hidden');
              }, 300);
            }
          });

          link.addEventListener('click', (e) => {
            e.preventDefault();
            if (citation) {
              if (isMobile()) {
                openMobileDrawer(citation);
              } else {
                showPopoverAtElement(link, citation);
              }
            }
          });

          sup.appendChild(link);
          fragment.appendChild(sup);
          lastIndex = regex.lastIndex;
        }

        if (lastIndex < text.length) {
          fragment.appendChild(document.createTextNode(text.substring(lastIndex)));
        }

        textNode.parentNode?.replaceChild(fragment, textNode);
      });
    }

    // Keep popover visible while hovering inside it
    popover?.addEventListener('mouseenter', () => {
      if (hideTimeout) clearTimeout(hideTimeout);
    });
    popover?.addEventListener('mouseleave', () => {
      hideTimeout = window.setTimeout(() => {
        popover?.classList.add('hidden');
      }, 300);
    });

    // Mobile drawer close
    document.getElementById('mobile-close-btn')?.addEventListener('click', () => {
      drawer?.classList.add('hidden');
    });
    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.add('hidden');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        popover?.classList.add('hidden');
        drawer?.classList.add('hidden');
      }
    });
  });
</script>
